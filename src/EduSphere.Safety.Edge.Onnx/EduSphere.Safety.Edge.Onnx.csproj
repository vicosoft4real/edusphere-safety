<!-- Requires Microsoft.ML.OnnxRuntime (pinned in Directory.Packages.props).
     Listed in EduSphere.Safety.slnx; restore from NuGet before building.
     See README.md in this directory and docs/edge-benchmark.md for the weights
     provenance procedure. SkiaSharp is NOT referenced here: detection-path
     resampling is pure C# in EduSphere.Safety.Edge (ImageSampling); SkiaSharp
     lives only in tools/Simulator. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EduSphere.Safety.Edge/EduSphere.Safety.Edge.csproj" />
  </ItemGroup>

</Project>
